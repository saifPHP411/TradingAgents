{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m tradingagents.paper_experiment.dashboard.server --root /home/appuser/app/data --host 0.0.0.0 --port $PORT --allow-paper-trading --paper-market-data binance_snapshot --paper-decision-source crypto --crypto-live",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 10,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "variables": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "TRADINGAGENTS_DASHBOARD_TOKEN": "{{DASHBOARD_TOKEN}}",
        "TRADINGAGENTS_CRYPTO_SYMBOLS": "BTC/USDT ETH/USDT SOL/USDT XRP/USD BNB/USD DOGE/USD AVAX/USD LINK/USD LTC/USD BCH/USD",
        "TRADINGAGENTS_PAPER_MARKET_DATA": "binance_snapshot",
        "TRADINGAGENTS_PAPER_DECISION_SOURCE": "crypto",
        "TRADINGAGENTS_PAPER_ORDER_NOTIONAL": "25"
      }
    }
  }
}