    "source_classifications": {
      "yahoo_prices": {
        "classification": "PIT_VERIFIED",
        "guard": "agents.tools.get_stock_data -> date_window.as_of_window",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "The agent tool clamps the requested window's end to the run's date before the vendor is called, so a bar after it is never returned. The clamp is in the tool layer, not the vendor: a direct call to the vendor or the router bypasses it, which is why the backtester reads bars from MarketDataFeed rather than calling the vendor itself. Adjusted prices reflect later splits and dividends, so a historical price is the split-adjusted value rather than the price on the tape that day."
      },
      "yahoo_indicators": {
        "classification": "PIT_VERIFIED",
        "guard": "agents.tools.get_indicators -> date_window.as_of_window",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "An indicator is computed from the price window, which is itself clamped to the run's date, so no future bar enters the calculation."
      },
      "sec_edgar": {
        "classification": "PIT_PARTIALLY_VERIFIED",
        "guard": "date_window.withhold_undated_statements",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": true,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "EDGAR serves US filings as filed, which is the right shape for a backtest. A statement whose filing date the vendor does not expose is withheld from a historical run rather than assumed to predate it, so a historical run may see less than was available rather than more. Restatements are served as filed, which is the point, but a filing dated by acceptance time can be a day late."
      },
      "fred": {
        "classification": "PIT_VERIFIED",
        "guard": "fred.get_macro_data (observation_end + vintage pinning)",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": true,
        "required_for_graph": false,
        "disables_cleanly": true,
        "internet_access": true,
        "note": "Observations are requested up to the run's date, clamped to FRED's own today, and a series with a vintage is pinned to it, so a revision published later does not appear in an earlier run. Publication lags mean a run may see a release before its figures were public in the ordinary case; the clamp bounds the window but does not model each series' release calendar."
      },
      "yahoo_news": {
        "classification": "PIT_PARTIALLY_VERIFIED",
        "guard": "agents.tools.get_news -> date_window.as_of_window + in_window + coverage_gap",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "Yahoo news search returns its latest items whatever window is asked for. Dated items are filtered to the window and an undated item is withheld from a historical run. A window the feed never observed is reported as unavailable rather than empty, so an absence is not invented."
      },
      "reddit": {
        "classification": "PIT_PARTIALLY_VERIFIED",
        "guard": "date_window.in_window + reddit._within_window + date_window.coverage_gap",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "The search API serves recent posts, so a window older than its lookback is reported as unobserved. Posts are filtered on their own created_utc, and an undated post is withheld from a historical run."
      },
      "stocktwits": {
        "classification": "PIT_PARTIALLY_VERIFIED",
        "guard": "date_window.in_window + stocktwits._within_window + date_window.coverage_gap",
        "historical": true,
        "has_availability_timestamp": true,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "The public feed serves the latest messages, so only recent windows are observed and an older one is reported as unavailable. Messages are filtered on their created_at."
      },
      "yahoo_profile": {
        "classification": "CURRENT_ONLY",
        "guard": "date_window.withhold_live_profile",
        "historical": false,
        "has_availability_timestamp": false,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "Company profile fields (sector, industry, name) are present-day snapshots with no historical view, so they are withheld entirely from a historical run rather than served as if they applied then. Companies are reclassified over time, so serving them would put post-decision information into the analysis. The withholding is the mitigation, not a point-in-time guarantee."
      },
      "insider_transactions": {
        "classification": "CURRENT_ONLY",
        "guard": "date_window.withhold_undisclosed_trades",
        "historical": false,
        "has_availability_timestamp": false,
        "revisions_possible": false,
        "required_for_graph": true,
        "disables_cleanly": false,
        "internet_access": true,
        "note": "The vendor does not date insider transactions by public disclosure, so a historical run cannot tell which trades were known on its date. They are withheld from a historical run rather than served as if disclosed."
      },
      "polymarket": {
        "classification": "CURRENT_ONLY",
        "guard": "none",
        "historical": false,
        "has_availability_timestamp": false,
        "revisions_possible": false,
        "required_for_graph": false,
        "disables_cleanly": true,
        "internet_access": true,
        "note": "Prediction-market prices are served as of now with no historical endpoint, so a backtest must not use them. There is no guard because there is nothing to clamp: the source has no date parameter to bound."
      }
