# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_BASE_URL=https://openrouter.ai/api   # Jev through OpenRouter, with an OpenRouter key above

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# ChatGPT Plus or Pro plan: no key; sign in once with `tradingagents login chatgpt`.
#TRADINGAGENTS_LLM_PROVIDER=chatgpt

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Turn off the start-up note about a newer release and Tauric Research notices.
#TRADINGAGENTS_NO_UPDATE_CHECK=1

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# Crypto (TJR on a 24/7 market)
# ---------------------------------------------------------------------------

# The crypto pairs the live dashboard section shows. Space-separated, "BASE/QUOTE".
# The default list is the liquid majors; the pair is checked against the venue's
# exchange info before any order is considered, and an unsupported pair is refused
# rather than sent.
#TRADINGAGENTS_CRYPTO_SYMBOLS=BTC/USDT ETH/USDT SOL/USDT XRP/USDT BNB/USDT DOGE/USDT AVAX/USDT LINK/USDT LTC/USDT BCH/USDT

# The pairs the *experiment* is created with. This is the list that is persisted
# into the experiment (the decision source and the risk book), and it is checked
# against BOTH venue registries: Binance's USDT pairs for the market data, and
# Alpaca's own listings for the execution side. A pair only one venue serves is
# reported and excluded, never substituted.
#TRADINGAGENTS_EXPERIMENT_SYMBOLS=BTC/USDT ETH/USDT SOL/USDT XRP/USDT BNB/USDT DOGE/USDT AVAX/USDT LINK/USDT LTC/USDT BCH/USDT

# Where the crypto backtest's 1-minute history is cached, so a study does not
# re-download what it already has. Unset uses the default cache directory.
#TRADINGAGENTS_CRYPTO_CACHE_DIR=./.crypto_cache

# Crypto market data comes from Binance's **public** REST and WebSocket endpoints:
# no API key, no account, and no rate limit tied to a paid tier. The public
# endpoints are documented at https://developers.binance.com/docs/binance-spot-api-docs
# and carry no key, so nothing is needed here.

# Alpaca **paper** credentials for crypto order routing. The paper endpoint is
# https://paper-api.alpaca.markets and the live endpoint is never used by this
# project. Get a free paper key at https://app.alpaca.markets/signup (the paper
# account needs no deposit; crypto trading on paper may still need the account
# to be enabled for crypto by Alpaca).
#ALPACA_PAPER_API_KEY=
#ALPACA_PAPER_API_SECRET=

# Dashboard token (required when binding to non-loopback hosts like Railway).
# Generate a strong random token: openssl rand -hex 32
#TRADINGAGENTS_DASHBOARD_TOKEN=

# Which market-data seam prices the paper worker's orders. "binance_snapshot"
# reads a live public Binance snapshot; "alpaca_snapshot" reads the Alpaca paper
# feed. The decision data and the execution price are deliberately separate.
#TRADINGAGENTS_PAPER_MARKET_DATA=binance_snapshot

# Which source feeds the paper worker its decisions. "crypto" runs the unchanged
# TJR rule chain over current Binance 1m/5m bars (no model); "current_market" asks
# the LLM over the same live window; "tjr" runs the chain over Alpaca's intraday
# feed; "history" replays a recorded experiment.
#TRADINGAGENTS_PAPER_DECISION_SOURCE=crypto

# The largest gap tolerated between the decision venue's price and the execution
# venue's price before the order is refused, as a fraction (0.05 = 5%). The two
# venues quote the same coin in different currencies, so they never agree exactly;
# beyond this bound the sizing would differ materially from the decision, so the
# order is refused rather than placed at an unexpected notional.
#TRADINGAGENTS_PAPER_MAX_PRICE_DEVIATION=0.05

# The maximum age of a market-data snapshot before it is refused, in seconds. A
# price older than this is not a current price, and sizing from it would size
# from a stale number.
#TRADINGAGENTS_PAPER_SNAPSHOT_MAX_AGE_SECONDS=15

# The cash target per paper order. The shared portfolio's hard cap is $25; this
# is the same cap, named for the operator.
#TRADINGAGENTS_PAPER_ORDER_NOTIONAL=25

# ---------------------------------------------------------------------------
# Railway deployment
# ---------------------------------------------------------------------------

# The container runs as root. The image's default user is the non-root
# `appuser`, which cannot write to a Railway volume mount: the first write fails
# with PermissionError and the worker's state never lands. Railway's documented
# remedy is to run the container as root, which this variable selects. The
# deployment files in this repository already set it to 0.
#RAILWAY_RUN_UID=0

# The directory the dashboard's state lives on. It must be the path the Railway
# volume is mounted at, otherwise the state is written to the container's
# ephemeral filesystem and a redeploy forgets which decisions already produced
# an order. The deployment files mount the volume at this path.
#TRADINGAGENTS_EXPERIMENT_ROOT=/home/appuser/app/data
